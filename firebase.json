{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/blog/page/:page",
        "destination": "/blog?page=:page",
        "type": 301
      },
      {
        "source": "/blog/page/:page/",
        "destination": "/blog?page=:page",
        "type": 301
      },
      {
        "source": "/contact-2",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/contact-2/",
        "destination": "/contact/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": {
          "functionId": "contactForm",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/appointment",
        "function": {
          "functionId": "appointmentForm",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/beat-offer",
        "function": {
          "functionId": "beatOfferForm",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/value-estimator",
        "function": {
          "functionId": "valueEstimatorForm",
          "region": "us-west1"
        }
      },
      {
        "source": "/api/cms-publish",
        "function": {
          "functionId": "cmsPublish",
          "region": "us-west1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
