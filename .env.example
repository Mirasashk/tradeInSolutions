# Site
NEXT_PUBLIC_SITE_URL=https://tradeinsolutions-irvine.com

# Firebase Web App (public site + admin)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tradeinsolutions-6f0e9
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (local build + migration scripts — never commit)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or file path / inline JSON for scripts:
# FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Firebase Functions secrets (set via `firebase functions:secrets:set`)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# CONTACT_FORM_TO_EMAIL=
# RECAPTCHA_SECRET_KEY=
# GITHUB_DISPATCH_TOKEN=

# Admin bootstrap (scripts/seed-admin.mjs)
# ADMIN_UID=
# ADMIN_EMAIL=

# Optional: Sanity migration (scripts/migrate-sanity-to-firestore.mjs)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
